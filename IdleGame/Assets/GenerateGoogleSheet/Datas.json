  "CreatureData": [
    {
      "DataID": 1,
      "Name": "Cleric",
      "NameKR": "클레릭",
      "Description": "클레릭은 신성한 신념을 바탕으로 전장의 최전선에서 동료들을 수호하는 자입니다. 단순히 상처를 고치는 것을 넘어, 아군의 사기를 높이고 절망적인 상황에서 기적을 불러일으키는 '살아있는 성소'와 같은 역할을 수행합니다.",
      "prefabName": "Cleric",
      "CreatureType": "Cleric",
      "Type": "Player",
      "AttackRange": 2,
      "CharacterGrade": "Common",
      "BaseHp": 50,
      "BaseDamage": 10,
      "MaxMp": 120,
      "ProjectileDataID": 20000,
      "SkillDataID": 40000
    },
    {
      "DataID": 2,
      "Name": "Archer",
      "NameKR": "궁수",
      "Description": "궁수는 정면 대결보다는 적의 약점을 파고드는 데 능숙합니다. 그가 쏘는 화살촉에는 연금술로 정제된 강력한 맹독이 발려 있어, 적의 갑옷을 부식시키고 신체 기능을 마비시킵니다. 적이 고통에 몸부림칠 때, 그는 이미 다음 사냥감을 향해 시위를 당기고 있습니다.",
      "prefabName": "Archer",
      "CreatureType": "Archer",
      "Type": "Player",
      "AttackRange": 2,
      "CharacterGrade": "Common",
      "BaseHp": 60,
      "BaseDamage": 12,
      "MaxMp": 80,
      "ProjectileDataID": 20003,
      "SkillDataID": 41000
    },
    {
      "DataID": 3,
      "Name": "Assassin",
      "NameKR": "암살자",
      "Description": "암살자는 소리 없이 다가와 단 한 번의 칼날질로 모든 상황을 종료시키는 전장의 집행자입니다. 화려한 동작보다는 효율적이고 정밀한 타격을 선호하며, 적이 가장 방심한 순간 가장 취약한 곳을 뚫고 들어갑니다. 그에게 찍힌 표적은 결코 살아서 전장을 벗어날 수 없습니다.",
      "prefabName": "Assassin",
      "CreatureType": "Assassin",
      "Type": "Player",
      "AttackRange": 1,
      "CharacterGrade": "UnCommon",
      "BaseHp": 70,
      "BaseDamage": 15,
      "MaxMp": 70,
      "ProjectileDataID": 20005,
      "SkillDataID": 42000
    },
    {
      "DataID": 4,
      "Name": "Hammer",
      "NameKR": "망치",
      "Description": "망치기사는 전장의 중심에서 거대한 망치를 휘둘러 적의 진형을 붕괴시키는 파괴의 선봉장입니다. 육중한 갑옷을 입고 묵직한 무기를 다루지만, 일단 회전력을 얻기 시작하면 그 누구도 멈출 수 없는 강철의 폭풍이 됩니다.",
      "prefabName": "Hammer",
      "CreatureType": "Hammer",
      "Type": "Player",
      "AttackRange": 1,
      "CharacterGrade": "Rare",
      "BaseHp": 70,
      "BaseDamage": 15,
      "MaxMp": 70,
      "ProjectileDataID": 20005,
      "SkillDataID": 43000
    },
    {
      "DataID": 5,
      "Name": "Knight",
      "NameKR": "기사",
      "Description": "기사는 전장의 선두에서 아군을 이끄는 정의의 상징입니다. 단순히 칼을 휘두르는 것에 그치지 않고, 자신의 투지와 신념을 '빛의 형상'으로 실체화하여 멀리 떨어진 적들까지 단죄합니다. 그의 검광이 번쩍일 때마다 적들은 두려움에 떨고, 동료들은 용기를 얻습니다.",
      "prefabName": "Knight",
      "CreatureType": "Knight",
      "Type": "Player",
      "AttackRange": 1,
      "CharacterGrade": "Unique",
      "BaseHp": 80,
      "BaseDamage": 17,
      "MaxMp": 70,
      "ProjectileDataID": 20005,
      "SkillDataID": 44000
    },
    {
      "DataID": 6,
      "Name": "SpearMan",
      "NameKR": "스피어맨",
      "Description": "스피어맨은 전장의 거리감을 지배하는 달인입니다. 검보다 길고 망치보다 날카로운 창을 자유자재로 휘둘러, 적이 접근하기도 전에 가로막거나 한꺼번에 쓸어버립니다. 그의 공격은 마치 몰아치는 태풍과 같아, 전방의 수많은 적을 단 한 번의 휘두름으로 저지하는 압도적인 위용을 보여줍니다.",
      "prefabName": "SpearMan",
      "CreatureType": "SpearMan",
      "Type": "Player",
      "AttackRange": 1,
      "CharacterGrade": "Unique",
      "BaseHp": 80,
      "BaseDamage": 17,
